{
  "data": {
    "features_path": "data/features.parquet",
    "churn_path": "data/churn_truth.csv"
  },
  "preprocessing": {
    "test_size": 0.4,
    "val_size": 0.5,
    "random_state": 42,
    "exclude_columns": [
      "subscriber_key",
      "churned",
      "main_node",
      "node_id",
      "main_category",
      "main_channel",
      "main_service",
      "main_tariff"
    ]
  },
  "model": {
    "n_estimators": 100,
    "max_depth": 10,
    "min_samples_split": 10,
    "min_samples_leaf": 5,
    "class_weight": "balanced",
    "random_state": 42,
    "n_jobs": -1
  },
  "artifacts": {
    "model_dir": "artifacts",
    "model_name": "best_model.pkl",
    "scaler_name": "scaler.pkl",
    "features_name": "features.json",
    "metrics_name": "metrics.json"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(levelname)s - %(message)s",
    "log_file": "pipeline.log"
  }
}